# Dependencies
node_modules/
app/node_modules/
pipeline/node_modules/

# Build outputs
dist/
app/dist/
*.tsbuildinfo

# Test artifacts
coverage/
playwright-report/
app/playwright-report/
test-results/
app/test-results/

# Pipeline intermediate downloads (raw source data, not the packed outputs)
pipeline/raw/
# No trailing slash on these two: a trailing slash matches DIRECTORIES ONLY, and
# a worktree that reaches the shared caches by SYMLINK has a symlink here, not a
# directory — so the slashed form left both untracked-but-not-ignored. A
# committed symlink stores its target STRING as blob content, i.e. an absolute
# path off this machine, in a public repo.
pipeline/data-src
pipeline/.venv
pipeline/bin/

# Local/session files
.claude/settings.local.json
.claude/worktrees/
.superpowers/
.remember/
graphify-out/
.playwright-mcp/
.env
.env.*

# Docs-only wind fixtures (#459/#462): the generator is committed
# (app/scripts/gen-docs-wind-fixture.mjs) and regenerating is already a
# mandatory pre-recapture step (its forecast horizon drifts in ~6 days), so
# the generated output would be dead weight in git history and in every
# deployed ref (app/public/** is copied verbatim into dist) for bytes nobody
# is ever meant to read against directly. Exact filename, not a glob over
# test-fixtures/, so this can never shadow the E2E suite's committed
# wind-sw12.json or any future e2e fixture added under the same directory.
app/public/test-fixtures/wind-docs-plan-route.json

# OS noise
.DS_Store
