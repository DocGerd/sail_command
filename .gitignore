# Dependencies
node_modules/
app/node_modules/
pipeline/node_modules/

# Build outputs
dist/
app/dist/
*.tsbuildinfo

# Test artifacts
coverage/
playwright-report/
app/playwright-report/
test-results/
app/test-results/

# Pipeline intermediate downloads (raw source data, not the packed outputs)
pipeline/raw/
# No trailing slash on these two: a trailing slash matches DIRECTORIES ONLY, and
# a worktree that reaches the shared caches by SYMLINK has a symlink here, not a
# directory — so the slashed form left both untracked-but-not-ignored. A
# committed symlink stores its target STRING as blob content, i.e. an absolute
# path off this machine, in a public repo.
pipeline/data-src
pipeline/.venv
pipeline/bin/

# Local/session files
.claude/settings.local.json
.claude/worktrees/
.superpowers/
.remember/
graphify-out/
.playwright-mcp/
.env
.env.*

# OS noise
.DS_Store
