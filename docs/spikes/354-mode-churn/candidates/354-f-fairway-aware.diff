new file mode 100644
--- /dev/null
+++ b/app/src/lib/fairway.ts
@@ -0,0 +1,110 @@
+import type { LatLon } from '../types';
+import { haversineNm, crossTrackNm, alongTrackFraction } from './geo';
+
+/**
+ * #354 candidate F ("fairway-aware") — the MINIMAL routing-input shape.
+ *
+ * A `FairwayField` answers exactly one question for the solver: is this edge
+ * OUTSIDE every corridor the router has been told to hold? Nothing else. The
+ * corridor GEOMETRY and, critically, the corridor WIDTH stay on this side of
+ * the boundary, because #244 measured that no source in this operating area
+ * carries a width at all (`docs/spikes/244-buoyed-fairways.md` §2.1: zero
+ * width/depth/draft tags across all 258 `waterway=fairway` ways). Keeping the
+ * width behind this interface means the solver never invents one; a caller
+ * that has no width also has no field to pass, and the solver is unchanged.
+ *
+ * This is spike §6.1 "Option A — corridor as a cost term", which the spike
+ * calls "structurally the cleanest option" and then rejects on DATA, not
+ * design. It is implemented here so that rejection can be measured rather than
+ * only cited.
+ */
+export interface FairwayField {
+  /**
+   * True when the a→b edge should be charged the out-of-corridor cost.
+   * Implementations must be pure and cheap: this is called once per candidate
+   * edge, inside the solver's innermost expansion loop.
+   */
+  outsideCorridor(a: LatLon, b: LatLon): boolean;
+}
+
+/**
+ * A corridor as the router would have to model one: a centreline plus a
+ * half-width. `halfWidthNm` is the number #244 §2.1/§6.1 says does not exist
+ * in any available source — it is a REQUIRED field here precisely so that it
+ * cannot be defaulted into existence.
+ */
+export interface FairwayCorridor {
+  readonly line: readonly LatLon[];
+  readonly halfWidthNm: number;
+}
+
+/** Perpendicular distance (nm) from p to a polyline, clamped at the ends. */
+function distanceToLineNm(p: LatLon, line: readonly LatLon[]): number {
+  if (line.length === 0) return Number.POSITIVE_INFINITY;
+  if (line.length === 1) return haversineNm(p, line[0]);
+  let best = Number.POSITIVE_INFINITY;
+  for (let i = 0; i + 1 < line.length; i++) {
+    const a = line[i];
+    const b = line[i + 1];
+    const f = alongTrackFraction(p, a, b);
+    const d =
+      f <= 0 ? haversineNm(p, a) : f >= 1 ? haversineNm(p, b) : Math.abs(crossTrackNm(p, a, b));
+    if (d < best) best = d;
+  }
+  return best;
+}
+
+/**
+ * Builds a field from explicit corridors. An EMPTY corridor list yields a
+ * field whose `outsideCorridor` is constantly false — i.e. it charges nothing
+ * anywhere — which is what every caller reading today's shipped assets gets
+ * (see {@link fairwayCorridorsFromGeoJson}).
+ *
+ * Membership is tested at the edge MIDPOINT: one point per candidate edge, the
+ * cheapest test that still asks about the water actually crossed rather than
+ * about the node the search happens to sit on.
+ */
+export function fairwayFieldFrom(corridors: readonly FairwayCorridor[]): FairwayField {
+  return {
+    outsideCorridor(a: LatLon, b: LatLon): boolean {
+      if (corridors.length === 0) return false;
+      const mid: LatLon = { lat: (a.lat + b.lat) / 2, lon: (a.lon + b.lon) / 2 };
+      for (const c of corridors) {
+        if (distanceToLineNm(mid, c.line) <= c.halfWidthNm) return false;
+      }
+      return true;
+    },
+  };
+}
+
+/**
+ * Extracts corridors from a seamark-style GeoJSON FeatureCollection.
+ *
+ * MEASURED AGAINST THE SHIPPED ASSET, 2026-09-02: `app/public/data/seamarks.json`
+ * holds 1,794 features and every one of them is a `Point` (`buoy_lateral` 689,
+ * `buoy_special_purpose` 445, `beacon_special_purpose` 258, …) — there is no
+ * `LineString` of any kind, and no `fairway` type at all.
+ * `pipeline/build_seamarks.mjs` queries `node["seamark:type"]` only, so that is
+ * true by construction, not by chance (#244 §1.3). This function therefore
+ * returns `[]` for the only asset the app actually ships, and no `halfWidthNm`
+ * is ever fabricated because none is ever read.
+ */
+export function fairwayCorridorsFromGeoJson(
+  fc: {
+    features?: readonly {
+      geometry?: { type?: string; coordinates?: unknown };
+      properties?: Record<string, unknown>;
+    }[];
+  },
+  halfWidthNm: number,
+): FairwayCorridor[] {
+  const out: FairwayCorridor[] = [];
+  for (const f of fc.features ?? []) {
+    if (f.geometry?.type !== 'LineString') continue;
+    if (f.properties?.['seamarkType'] !== 'fairway') continue;
+    const coords = f.geometry.coordinates as [number, number][] | undefined;
+    if (!coords || coords.length < 2) continue;
+    out.push({ line: coords.map(([lon, lat]) => ({ lat, lon })), halfWidthNm });
+  }
+  return out;
+}
