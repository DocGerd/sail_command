+/**
+ * #354 candidate D: absorb a SHORT sail run sandwiched between two motor legs
+ * into ONE motor leg spanning the whole sandwich, re-validated at the SAME
+ * per-cell gate the solve used (#452 graft 5).
+ *
+ * THIS VIOLATES A STANDING RULE. CLAUDE.md and the motor spec §8.6 both state
+ * that the only allowed post-processing is merging NEAR-COLLINEAR legs with
+ * re-validation. Crossing the mode boundary changes a leg's KIND, hence what
+ * the plan CLAIMS the skipper should do. It exists here only to be measured;
+ * it must not ship without an explicit maintainer ruling lifting that rule.
+ *
+ * Deliberately NOT folded into `tryMerge`: a sandwich is a TRIPLE and
+ * `tryMerge(a, b)` has no lookahead, so a pairwise motor+sail merge would fire
+ * with no motor following it, converting a sail leg to motor for no reason.
+ * The `a.kind !== b.kind` early return is therefore not the only thing in the
+ * way — the pairwise SHAPE is.
+ *
+ * Timing: the merged leg keeps the sandwich's own start/end timestamps and
+ * derives `speedKn` from them, exactly as `tryMerge` does. Nothing downstream
+ * is re-timed, so `PlanResult.etaMs` (taken from the solver in `planRoute.ts`,
+ * `departureMs = res.etaMs`) still reconciles. The cost is that the merged
+ * MOTOR leg reports a speed that is not the motor speed.
+ */
+function absorbShortSailBetweenMotors(legs: Leg[], mask: NavMask, gate: DepthGate): Leg[] {
+  const out: Leg[] = [];
+  let i = 0;
+  while (i < legs.length) {
+    const a = legs[i];
+    if (a.kind === 'motor' && i + 2 < legs.length && legs[i + 1].kind === 'sail') {
+      let j = i + 1;
+      let runMs = 0;
+      while (j < legs.length && legs[j].kind === 'sail') {
+        runMs += legs[j].endTimeMs - legs[j].startTimeMs;
+        j++;
+      }
