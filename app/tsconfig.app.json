{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "WebWorker"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals", "vite-plugin-pwa/react", "vite-plugin-pwa/info"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // realmask/gpx/seamarkPopover: tests that need node builtins, kept out so
  // node globals/types never leak into browser app code (see
  // tsconfig.test.json, which picks them back up). changelogFragmentsFs.ts
  // (#189) is the same shape one level up: it's the actual `node:fs` half of
  // the changelog-fragment reader, imported only by vite.config.ts (never by
  // browser app code) — excluded here for the same reason, picked up by
  // tsconfig.test.json below. subPathMeta.test.ts (#318 fix-wave) is the same
  // shape again: it imports vite.config.ts (now that subPathMeta() is
  // exported) to pin the fail-closed guard directly, which pulled Node's
  // ambient `process` global into THIS program via vite.config.ts's own
  // node:fs/node:path/node:child_process imports — silently satisfying
  // PlannerPanel.dst.test.tsx's `@ts-expect-error process is not typed in
  // browser context` on an unrelated file (TS2578, caught by CI, not by a
  // local incremental `tsc -b`). Excluded here for the same reason as the
  // five above. glyphFallbackWarningGuard.test.ts (#320) is the same shape
  // again — reads installed node_modules source via `node:fs`.
  "exclude": [
    "src/**/realmask.repro.test.ts",
    "src/**/gpx.parse.test.ts",
    "src/**/seamarkPopover.coverage.test.ts",
    "src/**/changelogFragmentsFs.ts",
    "src/**/changelogFragmentsFs.test.ts",
    "src/**/subPathMeta.test.ts",
    "src/**/glyphFallbackWarningGuard.test.ts"
  ]
}
